# INCLUDES
# --------
# Local/Private config goes in the include
[include]
  path = ~/.gitconfig.local
# URL ALIASES
# -----------
# Alias for Dracula Org repositories
[url "https://github.com/dracula/"]
  insteadOf = dracula://
# COLORS
# ------
# Dracula Dark Theme
[color]
  ui = auto
[color "branch"]
  current = cyan bold reverse
  local = white
  plain =
  remote = cyan
[color "diff"]
  commit =
  func = cyan
  plain =
  whitespace = magenta reverse
  meta = white
  frag = cyan bold reverse
  old = red
  new = green
[color "grep"]
  context =
  filename =
  function =
  linenumber = white
  match =
  selected =
  separator =
[color "interactive"]
  error =
  header =
  help =
  prompt =
[color "status"]
  added = green
  changed = yellow
  header =
  localBranch =
  nobranch =
  remoteBranch = cyan bold
  unmerged = magenta bold reverse
  untracked = red
  updated = green bold
# DELTA
# -----
# Dracula theme for git-delta (session-diff tab, `git diff | delta`)
[delta]
  syntax-theme = Dracula
  dark = true
  line-numbers = true
  navigate = true
  plus-style = syntax "#2b4a3a"
  plus-emph-style = syntax "#3d6b4f"
  minus-style = syntax "#4a2b34"
  minus-emph-style = syntax "#6b3d4a"
  line-numbers-plus-style = "#50fa7b"
  line-numbers-minus-style = "#ff5555"
  line-numbers-zero-style = "#6272a4"
  line-numbers-left-style = "#6272a4"
  line-numbers-right-style = "#6272a4"
  file-style = bold "#ff79c6"
  file-decoration-style = "#ff79c6" ul
  hunk-header-style = file line-number syntax
  hunk-header-decoration-style = "#bd93f9" box
  hunk-header-file-style = "#8be9fd"
  hunk-header-line-number-style = "#f1fa8c"
  commit-decoration-style = "#bd93f9" box
  whitespace-error-style = "#ff79c6" reverse
